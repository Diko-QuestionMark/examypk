// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ROLE & USER MANAGEMENT
// ==========================================

enum Role {
  ADMIN
  TEACHER
}

model User {
  id        Int        @id @default(autoincrement())
  username  String     @unique
  password  String
  name      String
  role      Role       @default(TEACHER)
  createdAt DateTime   @default(now())

  // Relasi: Guru membuat banyak Paket Soal (ExamBank)
  examBanks ExamBank[]
}

// ==========================================
// MASTER DATA
// ==========================================

model Subject {
  id        Int        @id @default(autoincrement())
  name      String     @unique // cth: "Matematika", "Bahasa Inggris"
  
  // Relasi ke Paket Soal
  examBanks ExamBank[]
}

// ==========================================
// SISWA & SESI UJIAN
// ==========================================

model Student {
  id        Int      @id @default(autoincrement())
  nis       String   @unique
  password  String
  name      String
  kelas     String
  createdAt DateTime @default(now())
}

model ExamSession {
  id          String   @id @default(uuid())
  token       String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  // Sesi ujian ini menggunakan soal dari paket mana?
  examBankId  Int
  examBank    ExamBank @relation(fields: [examBankId], references: [id])
}

// ==========================================
// BANK SOAL & PERTANYAAN
// ==========================================

enum ExamStatus {
  DRAFT
  READY
}

model ExamBank {
  id          Int          @id @default(autoincrement())
  title       String       // cth: "UAS Ganjil Matematika X"
  
  subjectId   Int
  subject     Subject      @relation(fields: [subjectId], references: [id])
  
  authorId    Int
  author      User         @relation(fields: [authorId], references: [id])
  
  targetKelas String       // cth: "X-A", atau "Kelas X"
  status      ExamStatus   @default(DRAFT)
  createdAt   DateTime     @default(now())

  questions   Question[]
  sessions    ExamSession[]
}

model Question {
  id            Int      @id @default(autoincrement())
  text          String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  optionE       String
  correctAnswer String
  
  // Relasi ke Paket Soal
  examBankId    Int
  examBank      ExamBank @relation(fields: [examBankId], references: [id])
  
  createdAt     DateTime @default(now())
}
